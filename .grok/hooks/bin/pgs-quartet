#!/usr/bin/env bash
# Sticky on/off control for the PGS Quartet hard gate.
#
# Usage:
#   pgs-quartet off      # disable gate (allow all parent tools)
#   pgs-quartet on       # enable gate (spawn-four required)
#   pgs-quartet status   # print current effective setting
#
# The gate hook reads ~/.grok/state/pgs-quartet-enabled itself.
# Setting PGS_QUARTET_BYPASS=1 only inside a blocked shell command does NOT work;
# use this sticky file, or export env on the Grok CLI process.

set -euo pipefail

STATE_DIR="${HOME}/.grok/state"
FLAG="${STATE_DIR}/pgs-quartet-enabled"

usage() {
  cat <<'EOF'
Usage: pgs-quartet on|off|status

  on      Enable the PGS Quartet hard gate (sticky)
  off     Disable the gate (sticky; parent tools unrestricted)
  status  Show sticky file + process env that affect the gate

Sticky file: ~/.grok/state/pgs-quartet-enabled  (0=off, 1=on)
Process env (Grok CLI process only):
  PGS_QUARTET=0 | PGS_QUARTET_ENABLED=0  -> off
  PGS_QUARTET=1 | PGS_QUARTET_ENABLED=1  -> on (overrides file)
  PGS_QUARTET_BYPASS=1                   -> emergency off
Default when file missing and env unset: OFF
EOF
}

read_flag() {
  if [[ ! -f "$FLAG" ]]; then
    echo "missing"
    return
  fi
  # first non-empty token of first line
  head -n 1 "$FLAG" 2>/dev/null | tr -d '\r' | awk '{print tolower($1)}' || true
}

case "${1:-}" in
  on|enable|1)
    mkdir -p "$STATE_DIR"
    printf '1\n' >"$FLAG"
    echo "PGS Quartet gate: ON (wrote $FLAG)"
    echo "Take effect: already active on next PreToolUse (no CLI restart required)."
    ;;
  off|disable|0)
    mkdir -p "$STATE_DIR"
    printf '0\n' >"$FLAG"
    echo "PGS Quartet gate: OFF (wrote $FLAG)"
    echo "Parent tools are unrestricted inside prime-gap-structure."
    echo "Take effect: already active on next PreToolUse (no CLI restart required)."
    ;;
  status|s)
    flag_val="$(read_flag)"
    case "$flag_val" in
      0|off|false|no|disabled|disable) sticky="OFF ($flag_val)" ;;
      1|on|true|yes|enabled|enable) sticky="ON ($flag_val)" ;;
      missing) sticky="missing (default OFF)" ;;
      *) sticky="unrecognized ($flag_val); default OFF" ;;
    esac
    echo "Sticky file: $FLAG"
    echo "Sticky value: $sticky"
    echo "PGS_QUARTET_BYPASS=${PGS_QUARTET_BYPASS:-<unset>}"
    echo "PGS_QUARTET_ENABLED=${PGS_QUARTET_ENABLED:-<unset>}"
    echo "PGS_QUARTET=${PGS_QUARTET:-<unset>}"
    # Best-effort effective status (mirrors hook priority without Python).
    if [[ "${PGS_QUARTET_BYPASS:-}" == "1" ]]; then
      echo "Effective: OFF (PGS_QUARTET_BYPASS=1)"
    elif [[ -n "${PGS_QUARTET_ENABLED:-}" ]]; then
      case "$(printf '%s' "$PGS_QUARTET_ENABLED" | tr '[:upper:]' '[:lower:]')" in
        0|off|false|no|disabled) echo "Effective: OFF (PGS_QUARTET_ENABLED)" ;;
        1|on|true|yes|enabled) echo "Effective: ON (PGS_QUARTET_ENABLED)" ;;
        *) echo "Effective: unknown (PGS_QUARTET_ENABLED=$PGS_QUARTET_ENABLED)" ;;
      esac
    elif [[ -n "${PGS_QUARTET:-}" ]]; then
      case "$(printf '%s' "$PGS_QUARTET" | tr '[:upper:]' '[:lower:]')" in
        0|off|false|no|disabled) echo "Effective: OFF (PGS_QUARTET)" ;;
        1|on|true|yes|enabled) echo "Effective: ON (PGS_QUARTET)" ;;
        *) echo "Effective: unknown (PGS_QUARTET=$PGS_QUARTET)" ;;
      esac
    else
      case "$flag_val" in
        0|off|false|no|disabled|disable) echo "Effective: OFF (sticky file)" ;;
        1|on|true|yes|enabled|enable) echo "Effective: ON (sticky file)" ;;
        missing) echo "Effective: OFF (default; sticky missing)" ;;
        *) echo "Effective: OFF (unrecognized sticky; default)" ;;
      esac
    fi
    ;;
  -h|--help|help|"")
    usage
    if [[ -z "${1:-}" ]]; then
      exit 2
    fi
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
