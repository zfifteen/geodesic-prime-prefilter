{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bin/pgs_quartet_gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bin/pgs_quartet_gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "spawn_subagent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bin/pgs_quartet_gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bin/pgs_quartet_gate.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
